# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

CEREBRAS_API_KEY=your_cerebras_api_key
CARTESIA_API_KEY=your_cartesia_api_key
# App
DATABASE_PATH=.data/restaurant_voice_agent.sqlite3
PUBLIC_APP_URL=http://localhost:8000
CEREBRAS_MODEL=gemma-4-31b
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
LIVEKIT_STT_LANGUAGE=en
LIVEKIT_TTS_LANGUAGE=en

# Local-only prototype pipeline.
# Used by: uv run python scripts/prototype_voice_pipeline.py console
LOCAL_LLM_MODEL=gpt-4.1-mini
LOCAL_STT_LANGUAGE=en
LOCAL_XAI_TTS_LANGUAGE=en
LOCAL_XAI_TTS_VOICE=ara
